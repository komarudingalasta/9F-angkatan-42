rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Versi sederhana: hanya pengguna yang sudah login Firebase Authentication
    // yang boleh membaca atau mengubah data aplikasi.
    match /records/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /subjects/{subjectId} {
      allow read, write: if request.auth != null;
    }

    // Semua koleksi lain ditutup secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
