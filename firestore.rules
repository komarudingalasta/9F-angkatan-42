rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && myProfile().data.role == "admin";
    }

    function isStudent() {
      return signedIn()
        && myProfile().data.role == "student";
    }

    function myNis() {
      return myProfile().data.nis;
    }

    function myClass() {
      return myProfile().data.attendanceHelperClass;
    }

    function isAttendanceHelper() {
      return isStudent()
        && myProfile().data.attendanceHelper == true;
    }


    // =========================
    // AKUN / PROFIL
    // =========================
    match /users/{uid} {
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // DATA NILAI
    // =========================
    match /records/{recordId} {
      allow read: if isAdmin()
        || (
          isStudent()
          && resource.data.nis == myNis()
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // RINGKASAN AKADEMIK
    // =========================
    match /studentSummaries/{summaryId} {
      allow read: if isAdmin()
        || (
          isStudent()
          && resource.data.nis == myNis()
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // MATA PELAJARAN
    // =========================
    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================
    // KEHADIRAN
    // =========================
    match /attendance/{attendanceId} {

      // Admin membaca semua.
      // Siswa biasa hanya membaca kehadirannya sendiri.
      // Petugas siswa hanya membaca kehadiran kelasnya.
      allow read: if isAdmin()
        || (
          isStudent()
          && resource.data.nis == myNis()
        )
        || (
          isAttendanceHelper()
          && resource.data.kelas == myClass()
        );

      // Admin dapat membuat data apa pun.
      // Petugas siswa hanya boleh membuat data untuk kelasnya
      // dan sumber harus "Petugas Siswa".
      allow create: if isAdmin()
        || (
          isAttendanceHelper()
          && request.resource.data.kelas == myClass()
          && request.resource.data.source == "Petugas Siswa"
        );

      // Petugas siswa tidak boleh menimpa data yang berasal
      // dari pengajuan izin/sakit yang sudah disetujui.
      allow update: if isAdmin()
        || (
          isAttendanceHelper()
          && resource.data.kelas == myClass()
          && request.resource.data.kelas == myClass()
          && resource.data.source != "Pengajuan"
          && request.resource.data.source == "Petugas Siswa"
        );

      allow delete: if isAdmin();
    }


    // =========================
    // PENGAJUAN IZIN / SAKIT
    // =========================
    match /leaveRequests/{requestId} {

      // Admin melihat seluruh pengajuan.
      // Siswa hanya melihat pengajuan miliknya.
      allow read: if isAdmin()
        || (
          isStudent()
          && resource.data.nis == myNis()
        );

      // Siswa hanya boleh membuat pengajuan untuk dirinya.
      allow create: if isStudent()
        && request.resource.data.nis == myNis()
        && request.resource.data.status == "Menunggu"
        && (
          request.resource.data.type == "Sakit"
          || request.resource.data.type == "Izin"
        );

      // Approval/reject hanya admin.
      allow update, delete: if isAdmin();
    }


    // =========================
    // DATA LAIN DITUTUP
    // =========================

    match /classRoster/{rosterId} {
      // classRoster only contains NIS, name, and class; no academic scores.
      // Attendance helpers need to list it to build the manual attendance screen.
      allow read: if isAdmin() || isAttendanceHelper();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
